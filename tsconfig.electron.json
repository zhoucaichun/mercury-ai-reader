{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist-electron",
    "rootDir": ".",
    "types": ["node", "electron"]
  },
  "include": [
    "electron",
    "src/core/database/**/*.ts",
    "src/features/feed/**/*.ts",
    "src/features/reader/pipeline/**/*.ts"
  ]
}
